MONGO_URL=mongodb://localhost:27017/iron-coach
# Required, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=4000
# Only needed when deployed on Vercel:
# BLOB_READ_WRITE_TOKEN is added by Vercel when a Blob store is connected to the project.
# CRON_SECRET protects the daily demo cleanup, at least 16 characters.

# AI roasts are off unless AI_ROASTS_ENABLED=true, because real replies included a violent threat in testing, and nothing filters them.
# A provider with no key is skipped. With AI off or no keys, the coach uses the roast bank.
AI_ROASTS_ENABLED=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Only the /machine-lab page uses this, from https://aistudio.google.com/apikey.
# On the free tier Google can use these photos to improve its products, and humans may review them.
GEMINI_API_KEY=
